{
    "name": "beres/settings",
    "description": "Beres Commerce Settings Module",
    "type": "bagisto-package",
    "keywords": ["laravel", "bagisto", "settings", "configuration", "ecommerce"],
    "license": "proprietary",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Beres\\Settings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beres\\Settings\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beres\\Settings\\Providers\\SettingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
