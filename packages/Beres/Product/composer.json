{
    "name": "beres/product",
    "description": "Beres Commerce Product Management Module",
    "type": "bagisto-package",
    "keywords": ["laravel", "bagisto", "product", "ecommerce"],
    "license": "proprietary",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Beres\\Product\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beres\\Product\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beres\\Product\\Providers\\ProductServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
