{
    "name": "beres/checkout",
    "description": "Beres Commerce Checkout Module",
    "type": "bagisto-package",
    "keywords": ["laravel", "bagisto", "checkout", "ecommerce"],
    "license": "proprietary",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Beres\\Checkout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beres\\Checkout\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beres\\Checkout\\Providers\\CheckoutServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
