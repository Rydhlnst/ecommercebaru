{
    "name": "beres/payment",
    "description": "Beres Commerce Payment Integration Module (Midtrans)",
    "type": "bagisto-package",
    "keywords": ["laravel", "bagisto", "payment", "midtrans", "ecommerce"],
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "midtrans/midtrans-php": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Beres\\Payment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beres\\Payment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beres\\Payment\\Providers\\PaymentServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
