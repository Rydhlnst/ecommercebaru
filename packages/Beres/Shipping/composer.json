{
    "name": "beres/shipping",
    "description": "Beres Commerce Shipping Integration Module (RajaOngkir)",
    "type": "bagisto-package",
    "keywords": ["laravel", "bagisto", "shipping", "rajaongkir", "ecommerce"],
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Beres\\Shipping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beres\\Shipping\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beres\\Shipping\\Providers\\ShippingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
