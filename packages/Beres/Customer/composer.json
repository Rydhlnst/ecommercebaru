{
    "name": "beres/customer",
    "description": "Beres Commerce Customer Management Module",
    "type": "bagisto-package",
    "keywords": ["laravel", "bagisto", "customer", "ecommerce"],
    "license": "proprietary",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Beres\\Customer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beres\\Customer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beres\\Customer\\Providers\\CustomerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
