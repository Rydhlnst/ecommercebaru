{
    "name": "beres/order",
    "description": "Beres Commerce Order Management Module",
    "type": "bagisto-package",
    "keywords": ["laravel", "bagisto", "order", "ecommerce"],
    "license": "proprietary",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Beres\\Order\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beres\\Order\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beres\\Order\\Providers\\OrderServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
