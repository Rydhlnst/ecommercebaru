{
    "name": "beres/inventory",
    "description": "Beres Commerce Inventory Management Module",
    "type": "bagisto-package",
    "keywords": ["laravel", "bagisto", "inventory", "ecommerce"],
    "license": "proprietary",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Beres\\Inventory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beres\\Inventory\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beres\\Inventory\\Providers\\InventoryServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
