###########################################
# Ankesh Mart — Docker Production .env
# Semua port host di-offset +200 dari default
###########################################

APP_NAME="Ankesh Mart"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://your-domain.com:280

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_CURRENCY=IDR

###########################################
# Host Ports (default + 200)
###########################################
# HTTP     80   -> 280
# HTTPS    443  -> 643
# MySQL    3306 -> 3506
# Redis    6379 -> 6579
# PHP-FPM  9000 -> 9200  (internal only)

APP_PORT=280
APP_PORT_SSL=643
DB_PORT_HOST=3506
REDIS_PORT_HOST=6579

###########################################
# Database (MySQL container)
###########################################
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=beres_commerce
DB_USERNAME=beres
DB_PASSWORD=changeme_strong_password
DB_ROOT_PASSWORD=changeme_root_password

###########################################
# Cache / Session / Queue (Redis container)
###########################################
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

###########################################
# Logging
###########################################
LOG_CHANNEL=stack
LOG_LEVEL=error
LOG_STACK=single

###########################################
# Mail (SMTP)
###########################################
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

###########################################
# Midtrans (Payment)
###########################################
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_FINISH_URL="${APP_URL}/checkout/success"
MIDTRANS_UNFINISH_URL="${APP_URL}/checkout"
MIDTRANS_ERROR_URL="${APP_URL}/checkout"

###########################################
# RajaOngkir (Shipping)
###########################################
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN_CITY=501
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter

###########################################
# Bagisto
###########################################
APP_ADMIN_URL_PATH=admin
BAGISTO_GRAPHQL_ENABLED=false
ADMIN_LOGO_PATH=
ADMIN_FAVICON_PATH=

VITE_APP_NAME="${APP_NAME}"
