###########################################
# Ankish Mart — Production .env
###########################################

APP_NAME="Ankish Mart"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DEBUG_ALLOWED_IPS=
APP_URL=http://your-domain.com:280
APP_ADMIN_URL=backend

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_CURRENCY=IDR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Host Ports ──────────────────────────────────────────────────────────────
APP_PORT=280
DB_PORT_HOST=3506
REDIS_PORT_HOST=6579

# ─── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ankish_mart
DB_USERNAME=ankish
DB_PASSWORD=ankish_secret_2026
DB_ROOT_PASSWORD=ankish_root_2026
DB_PREFIX=

# ─── Session / Cache / Queue ────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Deploy ──────────────────────────────────────────────────────────────────
DEPLOY_SECRET=ankish_deploy_secret_2026_change_me
DEPLOY_ALLOWED_IPS=

# ─── Mail (SMTP) ────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_MAIL_ADDRESS="admin@your-domain.com"
ADMIN_MAIL_NAME="Admin"
CONTACT_MAIL_ADDRESS="contact@your-domain.com"
CONTACT_MAIL_NAME="Contact"

# ─── Midtrans (Payment) ─────────────────────────────────────────────────────
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_FINISH_URL="${APP_URL}/checkout/success"
MIDTRANS_UNFINISH_URL="${APP_URL}/checkout"
MIDTRANS_ERROR_URL="${APP_URL}/checkout"

# ─── RajaOngkir (Shipping) ──────────────────────────────────────────────────
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN_CITY=501
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter

# ─── Vite ────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_HOST=localhost
VITE_PORT=
