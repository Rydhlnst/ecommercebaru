###########################################
# Beres Commerce — Production .env
# Copy this to .env and fill in your values
###########################################

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME="Beres Commerce"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DEBUG_ALLOWED_IPS=
APP_URL=https://your-domain.com
APP_ADMIN_URL=backend

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_CURRENCY=IDR

APP_MAINTENANCE_DRIVER=file

# ─── Host Ports ──────────────────────────────────────────────────────────────
# HTTP     80   -> 280 (change to 80 if no reverse proxy)
# MySQL    3306 -> 3506 (only expose for debugging, keep internal otherwise)
# Redis    6379 -> 6579 (only expose for debugging, keep internal otherwise)
APP_PORT=280
DB_PORT_HOST=3506
REDIS_PORT_HOST=6579

# ─── Database (MySQL container) ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=beres_commerce
DB_USERNAME=beres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_PREFIX=

# ─── Cache / Session / Queue ────────────────────────────────────────────────
# Option A: Redis (recommended for production)
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

# Option B: File-based (if Redis not available, uncomment below, comment Redis above)
# CACHE_STORE=file
# SESSION_DRIVER=file
# QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Deploy ──────────────────────────────────────────────────────────────────
DEPLOY_SECRET=GENERATE_WITH_php_r_echo_bin2hex_random_bytes_32
DEPLOY_ALLOWED_IPS=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=error
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Mail (SMTP) ────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_MAIL_ADDRESS="admin@your-domain.com"
ADMIN_MAIL_NAME="Admin"
CONTACT_MAIL_ADDRESS="contact@your-domain.com"
CONTACT_MAIL_NAME="Contact"

# ─── Midtrans (Payment) ─────────────────────────────────────────────────────
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_FINISH_URL="${APP_URL}/checkout/success"
MIDTRANS_UNFINISH_URL="${APP_URL}/checkout"
MIDTRANS_ERROR_URL="${APP_URL}/checkout"

# ─── RajaOngkir (Shipping) ──────────────────────────────────────────────────
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN_CITY=501
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter

# ─── Vite ────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_HOST=localhost
VITE_PORT=
